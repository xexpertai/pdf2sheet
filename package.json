{
  "name": "pdf2sheet",
  "version": "1.0.0",
  "description": "Extract tables from text-based PDFs in the browser and export clean XLSX/CSV. No uploads, works offline.",
  "type": "module",
  "license": "MIT",
  "author": "Harsha Shinde",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "samples": "python3 scripts/make-samples.py",
    "vendor": "node scripts/vendor-pdfjs.mjs",
    "serve": "python3 -m http.server 8080",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.1"
  }
}
